{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riffle.dev/contracts/mined_features.schema.json",
  "title": "Riffle mined repo-local features",
  "description": "Five features mined from git, CI and review history that capture how one repository behaves. Produced by the scorer's extractor at the PR's base commit, appended to the fixed feature vector, and emitted alongside evidence the narrator may cite. Point-in-time rule: only past PRs merged before this PR opened AND whose labels were mature at that moment may contribute. Only reviews completed before open count. null means not enough history (thresholds in rules.mining), never 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "columns",
    "evidence",
    "as_of"
  ],
  "properties": {
    "as_of": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "opened_at",
        "rules_hash"
      ],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "rules_hash": {
          "type": "string",
          "description": "Covers rules.mining parameters"
        }
      }
    },
    "columns": {
      "description": "Model inputs. Fixed names and types; order is set by the feature registry in the model version.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "similar_pr_bad_rate",
        "similar_pr_count",
        "revealed_path_scrutiny",
        "path_failure_mode_revert",
        "path_failure_mode_ci",
        "path_failure_mode_hotfix",
        "path_detection_lag_days",
        "path_size_pctile",
        "release_cycle_position"
      ],
      "properties": {
        "similar_pr_bad_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the k nearest past PRs (Jaccard over touched files, >= min_file_overlap) with label_bad. Smoothed toward repo_revert_base_rate when neighbours are few"
        },
        "similar_pr_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Neighbours actually found; lets the model discount a rate built on 3 PRs"
        },
        "revealed_path_scrutiny": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Mean over touched files of (review comments + 2 x changes_requested + rounds) on prior PRs, divided by the repo mean. 1.0 = typical for this repo"
        },
        "path_failure_mode_revert": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Share of past bad changes on these paths that were reverts"
        },
        "path_failure_mode_ci": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Share that were post-merge CI failures"
        },
        "path_failure_mode_hotfix": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Share that were hotfixes. The three shares sum to 1 when not null. Encoded as shares, not a category, so trees can split on them"
        },
        "path_detection_lag_days": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Median days from merge to the outcome event for past bad changes on these paths. High = failures here surface slowly"
        },
        "path_size_pctile": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Percentile of this PR's LA+LD among past changes to the same files (weighted by lines per file). Complements the repo-wide pr_size_pctile_repo"
        },
        "release_cycle_position": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Days since last release tag divided by the repo's typical release interval. Above 1 means a release is overdue"
        }
      }
    },
    "evidence": {
      "description": "Not model inputs. Concrete facts the narrator may quote. Everything here must be traceable to a column above.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "similar_prs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pr_number",
              "overlap",
              "outcome"
            ],
            "properties": {
              "pr_number": {
                "type": "integer"
              },
              "overlap": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "outcome": {
                "enum": [
                  "clean",
                  "revert",
                  "ci_fail",
                  "hotfix"
                ]
              },
              "merged_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "scrutiny_top_path": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "ratio": {
              "type": "number",
              "description": "Same unit as revealed_path_scrutiny"
            }
          }
        },
        "failure_mode_top": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "revert",
                "ci_fail",
                "hotfix"
              ]
            },
            "share": {
              "type": "number"
            },
            "median_lag_days": {
              "type": "number"
            },
            "sample_size": {
              "type": "integer"
            }
          }
        },
        "size_context": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "string",
              "description": "Directory or component the comparison used, e.g. streams/"
            },
            "pctile": {
              "type": "number"
            },
            "prior_changes": {
              "type": "integer"
            }
          }
        },
        "release_context": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "last_tag": {
              "type": "string"
            },
            "typical_interval_days": {
              "type": "number"
            },
            "expected_next_in_days": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
