{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riffle.dev/contracts/org_rules.schema.json",
  "title": "Riffle rules",
  "x-riffle-version": "5.3",
  "description": "How an organisation manages its code, as flat typed rules (kind + match + value). Orgs may write any number of rules, but the compiler always reduces them to the fixed column set in x-riffle-model-columns. Undeclared means null, never 0. Adding a column is a schema version bump, a retrain, and a decision record. Rules are read point-in-time from git history of the rules file, and the compiled hash is pinned into model_version. Read from the default branch only; an invalid file keeps the last valid compiled rules and posts a notice. Org file: riffle/rules.yml in the org's .github repo. Repo file: .github/riffle/rules.yml, appended after org rules and limited to that repo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "level",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^5\\.[0-9]+$"
    },
    "includes": {
      "description": "Other rule files in the same repo, so large orgs can split rules by team, e.g. riffle/rules/streams.yml. Resolved depth-first, max depth 2.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./-]+\\.ya?ml$"
      }
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "rules": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "labels": {
      "description": "How outcomes become the training target. Defaults follow docs/adr/0002-label-target.md. The global model always uses the default target_sources with binary union; org changes here apply only to that org's per-repo layer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "union",
            "weighted"
          ],
          "default": "union",
          "description": "union: label_bad = any target source fires (binary). weighted: each source's label_source weight becomes a sample weight. Per-repo layer only"
        },
        "szz_in_target": {
          "type": "boolean",
          "default": false,
          "description": "SZZ stays a separate label unless true"
        },
        "maturity_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 180,
          "default": 30,
          "description": "Rows younger than this are dropped before training (label_mature)"
        },
        "szz_maturity_days": {
          "type": "integer",
          "minimum": 30,
          "maximum": 365,
          "default": 90
        },
        "unobserved": {
          "enum": [
            "mask",
            "negative",
            "downweight"
          ],
          "default": "downweight",
          "description": "What to do when a label source had no data for a mature PR (e.g. CI results expired). Any observed source that fired still makes the row positive. Otherwise: mask drops the row; negative counts it as fully clean; downweight counts it as clean with sample weight unobserved_weight"
        },
        "unobserved_weight": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.5,
          "description": "downweight only. Multiplies the row's sample weight for each unobserved source (0.5 with one missing, 0.25 with two)"
        },
        "target_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "revert",
              "ci_fail",
              "hotfix",
              "szz",
              "follow_up_fix",
              "route_override",
              "incident_link",
              "external_import"
            ]
          },
          "default": [
            "revert",
            "ci_fail",
            "hotfix"
          ],
          "description": "Sources that can make a row positive. Others still get mined and reported as ablations, but do not enter the target"
        }
      }
    },
    "mining": {
      "description": "Parameters for the mined, repo-local features in contracts/mined_features.schema.json. They change model inputs, so they are part of the compiled rules hash pinned into model_version. Every value has a default; most repos never set this block.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "similar_prs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 3,
              "maximum": 20,
              "default": 5
            },
            "min_file_overlap": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1,
              "default": 0.2,
              "description": "Jaccard over touched files"
            },
            "lookback_days": {
              "type": "integer",
              "minimum": 30,
              "maximum": 1095,
              "default": 365
            },
            "min_neighbours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 3,
              "description": "Fewer than this and the feature is null"
            }
          }
        },
        "scrutiny": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lookback_days": {
              "type": "integer",
              "minimum": 30,
              "maximum": 1095,
              "default": 180
            },
            "exclude_bot_reviews": {
              "type": "boolean",
              "default": true
            },
            "min_prior_prs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 5
            }
          }
        },
        "failure_mode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lookback_days": {
              "type": "integer",
              "minimum": 90,
              "maximum": 1095,
              "default": 365
            },
            "min_bad_changes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 2
            }
          }
        },
        "path_size": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lookback_days": {
              "type": "integer",
              "minimum": 30,
              "maximum": 1095,
              "default": 365
            },
            "min_prior_changes": {
              "type": "integer",
              "minimum": 3,
              "maximum": 100,
              "default": 10
            }
          }
        },
        "release_cycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag_pattern": {
              "type": "string",
              "format": "regex",
              "default": "^v?\\d+\\.\\d+(\\.\\d+)?$",
              "description": "Which tags count as releases, e.g. ^\\d+\\.\\d+\\.0$ for minor releases only"
            },
            "min_releases": {
              "type": "integer",
              "minimum": 2,
              "maximum": 20,
              "default": 3
            },
            "interval_stat": {
              "enum": [
                "median",
                "mean"
              ],
              "default": "median"
            }
          }
        },
        "flaky_detection": {
          "type": "object",
          "additionalProperties": false,
          "description": "Marks checks flaky without test reports: a check that failed then passed on re-run at the same SHA. Adds to, never replaces, ci_check flaky rules",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "min_rerun_passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 3
            },
            "lookback_days": {
              "type": "integer",
              "minimum": 14,
              "maximum": 365,
              "default": 90
            }
          }
        }
      }
    },
    "level": {
      "enum": [
        "org",
        "repo"
      ]
    },
    "model": {
      "description": "Settings that change what the model sees or learns. They live here, not in org-config, so they are hashed into model_version.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_repo_layer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "false serves the global model only (layer_weight 0)"
            },
            "max_layer_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1.0
            }
          }
        },
        "disabled_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "x-riffle-merge": "union",
          "description": "Feature names forced to null. Width of the vector never changes. Repos may only add. Example: agent_authored"
        },
        "backfill": {
          "type": "object",
          "additionalProperties": false,
          "description": "On-install history mining. Recent history first so the per-repo layer can train within hours, then older history in the background",
          "properties": {
            "lookback_days": {
              "type": "integer",
              "minimum": 90,
              "maximum": 3650,
              "default": 1095
            },
            "recent_first_days": {
              "type": "integer",
              "minimum": 30,
              "maximum": 365,
              "default": 180
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sources": {
      "description": "Where outcome data lives beyond GitHub. Credentials are secret references, never values.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trackers": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "provider"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "provider": {
                "enum": [
                  "github",
                  "jira",
                  "linear",
                  "bugzilla",
                  "youtrack"
                ]
              },
              "base_url": {
                "type": "string",
                "format": "uri"
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "credentials_ref": {
                "type": "string"
              }
            }
          }
        },
        "ci": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "provider"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "provider": {
                "enum": [
                  "github_checks",
                  "commit_status",
                  "external_api"
                ],
                "description": "commit_status covers Jenkins, Buildkite and anything posting legacy statuses"
              },
              "context_glob": {
                "type": "string",
                "default": "*"
              },
              "credentials_ref": {
                "type": "string"
              }
            }
          }
        },
        "test_reports": {
          "x-riffle-phase": "later",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "format": {
              "enum": [
                "junit_xml"
              ],
              "default": "junit_xml"
            },
            "artifact_glob": {
              "type": "string",
              "default": "**/TEST-*.xml"
            }
          }
        },
        "outcome_import": {
          "description": "Lets an org push outcomes Riffle cannot see (internal incidents, internal reverts) to POST /v1/outcomes, keyed by commit SHA or PR. Contract: contracts/outcome_import.schema.json.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "secret_ref": {
              "type": "string"
            }
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "type": "string"
        },
        "applies_to": {
          "description": "Narrows where a rule applies. In a repo file, repos is ignored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repos": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "*"
              ]
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Limit to a monorepo package, e.g. packages/react-native/**"
            },
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "priority": {
          "description": "Conflict resolution: higher wins, then the more specific glob, then the later rule.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "$ref": "#/$defs/path_tier"
        },
        {
          "$ref": "#/$defs/path_class"
        },
        {
          "$ref": "#/$defs/sensitivity"
        },
        {
          "$ref": "#/$defs/change_signal"
        },
        {
          "$ref": "#/$defs/component"
        },
        {
          "$ref": "#/$defs/owner"
        },
        {
          "$ref": "#/$defs/policy"
        },
        {
          "$ref": "#/$defs/freeze_window"
        },
        {
          "$ref": "#/$defs/pr_label"
        },
        {
          "$ref": "#/$defs/safe_change"
        },
        {
          "$ref": "#/$defs/pattern"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/identity"
        },
        {
          "$ref": "#/$defs/merge_signal"
        },
        {
          "$ref": "#/$defs/issue_field"
        },
        {
          "$ref": "#/$defs/issue_label"
        },
        {
          "$ref": "#/$defs/author_class"
        },
        {
          "$ref": "#/$defs/ci_check"
        },
        {
          "$ref": "#/$defs/test_class"
        },
        {
          "$ref": "#/$defs/label_source"
        },
        {
          "$ref": "#/$defs/branch_class"
        },
        {
          "$ref": "#/$defs/stack"
        }
      ]
    },
    "path_tier": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "path_tier"
        },
        "match": {
          "type": "string"
        },
        "value": {
          "enum": [
            "low",
            "normal",
            "elevated",
            "critical"
          ]
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "feature",
      "x-riffle-compiles-to": [
        "max_criticality",
        "frac_lines_in_critical"
      ]
    },
    "path_class": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "path_class"
        },
        "match": {
          "type": "string"
        },
        "value": {
          "enum": [
            "excluded",
            "vendored",
            "generated",
            "lockfile",
            "test",
            "test_fixture",
            "docs",
            "config",
            "build_config",
            "dependency_manifest",
            "i18n"
          ]
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "feature | filter",
      "x-riffle-compiles-to": [
        "effective_lines_changed",
        "test_lines_ratio",
        "docs_only",
        "config_only"
      ]
    },
    "change_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "change_signal"
        },
        "match": {
          "type": "string"
        },
        "value": {
          "enum": [
            "schema_migration",
            "wire_protocol",
            "infra_as_code",
            "build_system",
            "dependency_bump",
            "feature_flag",
            "concurrency",
            "native_interop",
            "release_config"
          ]
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "feature",
      "x-riffle-compiles-to": [
        "sharpens extractor touches_* features; no new columns"
      ],
      "description": "Risky change types. Handled by the extractor's own path rules too; these declarations override its defaults per repo."
    },
    "component": {
      "description": "Names a monorepo package or module. The name is free text, but the model only sees generic stats computed per component from history.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "component"
        },
        "match": {
          "type": "string",
          "description": "e.g. streams/** or packages/virtualized-lists/**"
        },
        "value": {
          "$ref": "#/$defs/slug"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Availability tier, 1 is most critical"
        },
        "exposure": {
          "enum": [
            "internal",
            "partner",
            "external"
          ]
        },
        "data_class": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "regimes": {
          "type": "array",
          "items": {
            "enum": [
              "pci",
              "gdpr",
              "hipaa",
              "sox",
              "soc2",
              "fedramp"
            ]
          },
          "uniqueItems": true
        },
        "lifecycle": {
          "enum": [
            "experimental",
            "active",
            "stable",
            "deprecated"
          ]
        },
        "blast_radius": {
          "type": "integer",
          "minimum": 0,
          "description": "Declared downstream dependents"
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "feature",
      "x-riffle-compiles-to": [
        "n_components_touched",
        "max_criticality",
        "max_exposure",
        "max_data_class",
        "regulated_scope_count",
        "log_max_blast_radius",
        "touches_deprecated"
      ]
    },
    "owner": {
      "description": "Path ownership. import_codeowners reads CODEOWNERS instead of listing paths.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "owner"
        },
        "match": {
          "type": "string",
          "description": "Path glob, or the CODEOWNERS path when import_codeowners is true"
        },
        "value": {
          "type": "string",
          "description": "Team or login, e.g. @apache/kafka-streams"
        },
        "import_codeowners": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "feature",
      "x-riffle-compiles-to": [
        "author_is_owner",
        "owning_teams_touched (extractor, not a declared column)"
      ]
    },
    "pattern": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "pattern"
        },
        "match": {
          "type": "string",
          "format": "regex"
        },
        "value": {
          "enum": [
            "revert",
            "bugfix",
            "hotfix",
            "backport",
            "conventional_type",
            "security_fix"
          ]
        },
        "field": {
          "enum": [
            "commit_message",
            "commit_trailer",
            "pr_title",
            "pr_body",
            "branch_name"
          ],
          "default": "commit_message"
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "label | feature",
      "x-riffle-compiles-to": [
        "task_type",
        "is_backport",
        "labels: revert, bugfix"
      ]
    },
    "link": {
      "description": "Connects objects Riffle would otherwise treat as unrelated. match must contain a named group (?<ref>...).",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "link"
        },
        "match": {
          "type": "string",
          "format": "regex"
        },
        "field": {
          "enum": [
            "commit_message",
            "commit_trailer",
            "pr_title",
            "pr_body"
          ],
          "default": "commit_trailer"
        },
        "value": {
          "enum": [
            "pr_ref",
            "revert_target",
            "cherry_pick_source",
            "issue_key",
            "external_change_id"
          ]
        },
        "tracker": {
          "$ref": "#/$defs/slug",
          "description": "For issue_key: which sources.trackers entry"
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "link",
      "x-riffle-compiles-to": [
        "commit-PR-issue graph used by every label source; cherry picks dedupe labels across branches"
      ]
    },
    "identity": {
      "description": "Recovers the real person when a bot lands the commit or email differs from login. match needs a named group (?<login>...) or (?<email>...).",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "identity"
        },
        "match": {
          "type": "string",
          "format": "regex"
        },
        "on": {
          "enum": [
            "commit_trailer",
            "commit_message",
            "pr_body",
            "co_authored_by"
          ],
          "default": "commit_trailer"
        },
        "value": {
          "enum": [
            "author",
            "co_author",
            "reviewer",
            "lander"
          ]
        }
      },
      "required": [
        "match",
        "value"
      ],
      "unevaluatedProperties": false,
      "x-riffle-sink": "feature",
      "x-riffle-compiles-to": [
        "author_* features use the resolved author",
        "reviewer_count",
        "reviewer_path_experience"
      ]
    },
    "merge_signal": {
      "description": "What counts as merged. Needed when PRs are closed and the change lands another way.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "kind": {
          "const": "merge_signal"
        },
        "value": {
          "enum": [
            "github_merge",
            "linked_commit_on_default",
            "bot_close_with_commit",
            "direct_push"
          ]
        },
        "match": {
          "type": "string",
          "description": "Actor login for bot_close_with_commit, else '*'",
          "default": "*"
        }
      },
      "required": [
        "value"
      ],
      "unevaluatedProperties": false,
