# Copy to .env and fill in. .env is gitignored. Nothing here is a real secret.

# Linux and the GCP VM: set to the output of `id -u` so bind-mounted files stay
# owned by you. On Docker Desktop (Windows, macOS) leave it at 50000.
AIRFLOW_UID=50000

# Where the UI listens on the host. 127.0.0.1 keeps it private: on the VM, reach
# it through an SSH or IAP tunnel. Set 0.0.0.0 only behind a firewall rule or
# a TLS proxy that you control.
AIRFLOW_BIND_ADDR=127.0.0.1
AIRFLOW_PORT=8080

# Required. Generate each one; see README.md.
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
POSTGRES_PASSWORD=

# UI logins, one per person. AIRFLOW_USERS is name:role, comma separated.
# Roles: admin (everything), op (run and manage DAGs), user (edit DAG runs),
# viewer (read only). AIRFLOW_PASSWORDS is name:password for the same names.
# Passwords need 12+ characters and must not contain "," or ":".
# Example:
#   AIRFLOW_USERS=alice:admin,bob:viewer
#   AIRFLOW_PASSWORDS=alice:<generated>,bob:<generated>
AIRFLOW_USERS=
AIRFLOW_PASSWORDS=

# Set to true to load Airflow's bundled example DAGs.
AIRFLOW_LOAD_EXAMPLES=false
