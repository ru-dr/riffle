# Empty RIFFLE_BUCKET: everything stays on the volume (local use and tests).
# On the GCP VM, name the bucket; the VM's service account needs Storage Object Admin on it.
RIFFLE_BUCKET=
GOOGLE_CLOUD_PROJECT=
BQ_LOCATION=US

# Loopback unless a tunnel or TLS proxy sits in front.
RIFFLE_BIND_ADDR=127.0.0.1
RIFFLE_PORT=8470

# Public HTTPS (docker compose --profile public up -d). A name that points at this
# machine; sslip.io names such as 34-1-2-3.sslip.io work for a bare IP address.
RIFFLE_DOMAIN=
RIFFLE_PUBLIC_URL=
RIFFLE_TRUST_PROXY=0
RIFFLE_COOKIE_SECURE=0
