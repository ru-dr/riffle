# Empty RIFFLE_BUCKET: everything stays on the volume (local use and tests).
# On the GCP VM, name the bucket; the VM's service account needs Storage Object Admin on it.
RIFFLE_BUCKET=
GOOGLE_CLOUD_PROJECT=
BQ_LOCATION=US

# Loopback unless a tunnel or TLS proxy sits in front.
RIFFLE_BIND_ADDR=127.0.0.1
RIFFLE_PORT=8470
