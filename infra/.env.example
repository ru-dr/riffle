# Copy to .env (in this folder, next to compose.logging.yaml) and fill in.
# .env is gitignored. Nothing here is a real secret.

# Required. The Grafana admin login. Pick a password of your own; Grafana creates the
# account the first time it starts, so changing this later does not change the account.
# The password variable is named after Grafana's own setting so that Compose can pass it
# through without any value appearing in compose.logging.yaml. Grafana will not start
# while it is empty.
GRAFANA_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# How long Loki keeps logs, in hours (168h = 7 days, 720h = 30 days) or days (7d).
# Loki needs at least 24h. Older data is deleted by its compactor.
LOKI_RETENTION=168h

# Where the three web pages listen on the host. 127.0.0.1 keeps them private to this
# machine. Set 0.0.0.0 only behind a firewall: there is no login on Loki or Alloy.
LOGGING_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345

# The folder Alloy watches for commands run outside Docker: any *.log or *.jsonl file
# in it (and its subfolders) is shipped. Relative paths start at this folder.
# The default, ../logs, is <repo>/logs, which .gitignore covers.
# RIFFLE_LOGS_DIR=../logs
