# The key-encryption key of ADR 0025 (diagram: "Key vault · per-tenant keys"). Each tenant's
# data key is generated by the tenant workflow, wrapped (encrypted) with this key and stored
# wrapped; destroying a tenant's data key makes its objects unreadable. This key never leaves
# KMS: services ask KMS to wrap and unwrap.

# Key rings and keys can never be deleted in GCP, only their versions. A random suffix lets
# staging be destroyed and rebuilt without a name clash; an old, empty ring costs nothing.
resource "random_id" "suffix" {
  byte_length = 2
}

resource "google_kms_key_ring" "this" {
  project  = var.project_id
  name     = "${var.name}-${random_id.suffix.hex}"
  location = var.region
}

resource "google_kms_crypto_key" "tenant_kek" {
  name     = "tenant-kek"
  key_ring = google_kms_key_ring.this.id
  purpose  = "ENCRYPT_DECRYPT"

  # A new key version every 90 days. Old versions stay, so data keys wrapped earlier can still
  # be unwrapped; new wraps use the newest version.
  rotation_period = "${var.rotation_days * 86400}s"

  # A destroyed key version can be restored for this long.
  destroy_scheduled_duration = "${var.destroy_scheduled_days * 86400}s"

  version_template {
    algorithm        = "GOOGLE_SYMMETRIC_ENCRYPTION"
    protection_level = var.protection_level
  }

  labels = var.labels
}
