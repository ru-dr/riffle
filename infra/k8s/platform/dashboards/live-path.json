{
 "uid": "riffle-live-path",
 "title": "Riffle: live path",
 "tags": [
  "riffle"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "intake, scorer, the score-log writer and their queues. Alerts: infra/terraform/modules/monitoring.",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Intake: GitHub webhooks",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Webhooks by result",
   "description": "published, duplicate, ignored, in_flight, pong; failures: rejected (bad signature or request), publish_failed (Pub/Sub, answered 503)",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "sum by (result) (rate(riffle_intake_events_total{namespace=\"riffle-serving\"}[5m]))",
      "step": "60s"
     },
     "legendFormat": "{{result}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "intake latency",
   "description": "GitHub gives up at 10 s; the alert fires at p99 above 2 s",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "histogram_quantile(0.5, sum by (le) (rate(riffle_intake_latency_seconds_bucket{namespace=\"riffle-serving\"}[5m])))",
      "step": "60s"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "histogram_quantile(0.99, sum by (le) (rate(riffle_intake_latency_seconds_bucket{namespace=\"riffle-serving\"}[5m])))",
      "step": "60s"
     },
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "row",
   "title": "Scorer: ranking PRs",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "panels": []
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Model in service",
   "description": "riffle-outcome-setup-g@champion as loaded from MLflow; empty means no model (PRs stored unranked, model_unavailable)",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "max by (model_version, miner_version) (riffle_scorer_model_info{namespace=\"riffle-serving\"})",
      "step": "60s"
     },
     "legendFormat": "{{model_version}} (miner {{miner_version}})"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "name",
    "colorMode": "none"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Ranked share",
   "description": "Of the PRs the model could rank (outside contributors), the share that was ranked",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 8,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "sum(rate(riffle_scorer_messages_total{namespace=\"riffle-serving\", result=\"ranked\"}[15m])) / sum(rate(riffle_scorer_messages_total{namespace=\"riffle-serving\", result=~\"ranked|model_unavailable|scoring_failed|invalid_input\"}[15m]))",
      "step": "60s"
     },
     "legendFormat": "ranked"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Score log rows dropped (1 h)",
   "description": "ADR 0024: the score still posted; the row is missing from the score log",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 16,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "sum(increase(riffle_score_log_dropped_total{namespace=\"riffle-serving\"}[1h]))",
      "step": "60s"
     },
     "legendFormat": "dropped"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "PRs by result",
   "description": "ranked; unranked: not_outside_contributor (by design), model_unavailable, scoring_failed, invalid_input; duplicate (redelivered); retry and error (redelivered)",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
