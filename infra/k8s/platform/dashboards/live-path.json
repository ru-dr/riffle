  },
  {
   "id": 12,
   "type": "row",
   "title": "Queues: Pub/Sub",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 32
   },
   "panels": []
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Messages waiting",
   "description": "KEDA scales the scorer on scorer-pr-features",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "sum by (subscription_id) (pubsub_googleapis_com:subscription_num_undelivered_messages{monitored_resource=\"pubsub_subscription\", subscription_id=~\"riffle-staging-.*\", subscription_id!~\".*-dead-letter-hold\"})",
      "step": "60s"
     },
     "legendFormat": "{{subscription_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Oldest unacknowledged message",
   "description": "The alert fires above 5 minutes",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "max by (subscription_id) (pubsub_googleapis_com:subscription_oldest_unacked_message_age{monitored_resource=\"pubsub_subscription\", subscription_id=~\"riffle-staging-.*\", subscription_id!~\".*-dead-letter-hold\"})",
      "step": "60s"
     },
     "legendFormat": "{{subscription_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "In dead letter",
   "description": "Messages a consumer failed 5 times; kept 7 days",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "sum by (subscription_id) (pubsub_googleapis_com:subscription_num_undelivered_messages{monitored_resource=\"pubsub_subscription\", subscription_id=~\"riffle-staging-.*-dead-letter-hold\"})",
      "step": "60s"
     },
     "legendFormat": "{{subscription_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
