   "title": "Files written and failures",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "description": "A failure is retried; the alert fires after 15 minutes of failures",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 42
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
