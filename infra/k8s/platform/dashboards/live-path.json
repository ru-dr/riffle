  {
   "id": 11,
   "type": "timeseries",
   "title": "Deferred by fair share",
   "description": "A tenant over TENANT_MAX_IN_FLIGHT has its message redelivered later",
   "datasource": {
    "type": "stackdriver",
    "uid": "gmp"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "stackdriver",
      "uid": "gmp"
     },
     "queryType": "promQL",
     "promQLQuery": {
      "projectName": "riffle-infra-platform",
      "expr": "sum by (tenant) (rate(riffle_scorer_fair_share_deferred_total{namespace=\"riffle-serving\"}[5m]))",
      "step": "60s"
     },
     "legendFormat": "{{tenant}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
