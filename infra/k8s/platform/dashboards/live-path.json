  },
  {
   "id": 16,
   "type": "row",
   "title": "Logs",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 50
   },
   "panels": []
  },
  {
   "id": 17,
   "type": "logs",
   "title": "Errors and warnings (intake, scorer, score-log writer)",
   "description": "delivery_id and tenant_id are in each line",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 51
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "range",
     "expr": "{namespace=~\"riffle-serving|riffle-workers\", service=~\"intake|scorer|scorelog-writer\", level=~\"(?i)error|warn.*\"}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ],
