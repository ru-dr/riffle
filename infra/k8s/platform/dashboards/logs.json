{
 "uid": "riffle-logs",
 "title": "Riffle: logs",
 "tags": [
  "riffle"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "Logs of the Riffle services and the platform, from Loki (collected by Alloy: infra/k8s/apps/staging/12-alloy.yaml).",
 "templating": {
  "list": [
   {
    "type": "textbox",
    "name": "delivery_id",
    "label": "delivery_id",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "hide": 0
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Riffle services",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Errors per service",
   "description": "Error lines in 5 minutes, by service",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "range",
     "expr": "sum by (service) (count_over_time({namespace=~\"riffle-serving|riffle-workers|riffle-ml\", level=\"error\"}[5m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Warnings per service",
   "description": "Warning lines in 5 minutes, by service",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "range",
     "expr": "sum by (service) (count_over_time({namespace=~\"riffle-serving|riffle-workers|riffle-ml\", level=\"warning\"}[5m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "logs",
   "title": "Errors and warnings",
   "description": "Newest first; open a line to see delivery_id and tenant_id",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "range",
     "expr": "{namespace=~\"riffle-serving|riffle-workers|riffle-ml\", level=~\"error|warning\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
