{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/site/scripts/vercel-ignore.sh\"",
  "headers": [
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
