# Full-resolution source paintings (not served)
site/assets/source/

# Confidential design docs - marked "do not redistribute".
# Note: /docs at the repo root is the tracked engineering docs directory.
site/docs/

# Viewport probe, local debugging only
site/public/viewport.html

# Licensed fonts: free for personal use, not for distribution.
# next/font/local inlines them into hashed build assets at build time,
# so they must exist locally but are never committed or served raw.
site/assets/fonts/

# Derived woff2 subsets ARE committed (see site/public/fonts) - they are
# webfonts, not installable font files.

# Docs content compiled by site/scripts/build-docs.mjs on every dev/build.
site/components/docs/content.generated.ts
